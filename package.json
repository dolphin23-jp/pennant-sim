{
  "name": "pennant-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:baseline",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:baseline": "npm run baseline:compare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "baseline": "tsx scripts/balance-new-engine.ts --output baseline/season-stats.json",
    "baseline:new": "tsx scripts/balance-new-engine.ts",
    "baseline:compare": "npm run baseline:new && node scripts/compare-baselines.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.1.0"
  }
}
